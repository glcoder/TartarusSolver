<Window x:Class="Tartarus.App.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Tartarus.App.Localization"
        Title="{x:Static res:Strings.Main_ReportBug}" Width="460" SizeToContent="Height"
        Topmost="True" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="Segoe UI" FontSize="12" Background="#1E1F24" Foreground="#E8E8EC">
  <StackPanel Margin="12">
    <TextBlock x:Name="OnlyTartarus" Margin="0,0,0,10" Foreground="#E6B46E" TextWrapping="Wrap" />
    <TextBlock x:Name="Prompt" Text="{x:Static res:Strings.Report_WhatWentWrong}" Margin="0,0,0,6" TextWrapping="Wrap" />
    <TextBox x:Name="CommentBox" Height="120" PreviewKeyDown="CommentBox_PreviewKeyDown" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
             Background="#15161A" Foreground="#E8E8EC" BorderBrush="#3A3C44" CaretBrush="#E8E8EC" Padding="4" />
    <TextBlock Margin="0,8,0,0" Foreground="#9AA0AC" TextWrapping="Wrap"
               Text="{x:Static res:Strings.Report_Privacy}" />
    <TextBlock x:Name="StatusText" Margin="0,6,0,0" Foreground="#E6B46E" TextWrapping="Wrap" Visibility="Collapsed" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="SendButton" Content="{x:Static res:Strings.Report_Send}" ToolTip="Shift+Enter" Padding="12,3" Margin="0,0,6,0" IsDefault="False" Click="SendButton_Click" />
      <Button x:Name="CancelButton" Content="{x:Static res:Strings.Name_Cancel}" Padding="12,3" IsCancel="True" Click="CancelButton_Click" />
    </StackPanel>
  </StackPanel>
</Window>
