<Window x:Class="Tartarus.App.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Text recognition" Width="420" SizeToContent="Height"
        Topmost="True" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12" Background="#1E1F24" Foreground="#E8E8EC">
  <StackPanel Margin="12">
    <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,0,0,10" />
    <ProgressBar x:Name="Bar" Height="14" Minimum="0" Maximum="1" Visibility="Collapsed" />
    <TextBlock x:Name="Status" Margin="0,4,0,0" Foreground="#9AA0AC" TextWrapping="Wrap" Visibility="Collapsed" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="DownloadButton" Content="Download" Padding="12,3" Margin="0,0,6,0" IsDefault="True" Click="DownloadButton_Click" />
      <Button x:Name="CancelButton" Content="Not now" Padding="12,3" IsCancel="True" Click="CancelButton_Click" />
    </StackPanel>
  </StackPanel>
</Window>
