<Window x:Class="Tartarus.App.GameLanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game language" Width="420" SizeToContent="Height"
        Topmost="True" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12" Background="#1E1F24" Foreground="#E8E8EC">
  <StackPanel Margin="12">
    <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,0,0,10" />
    <ListBox x:Name="LanguageList" Background="#15161A" Foreground="#E8E8EC" BorderThickness="0" SelectionChanged="LanguageList_SelectionChanged" MouseDoubleClick="LanguageList_MouseDoubleClick">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Padding" Value="6,3" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Back" Background="Transparent" Padding="{TemplateBinding Padding}">
                  <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Back" Property="Background" Value="#2A2C33" />
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Back" Property="Background" Value="#2F5D9B" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
    </ListBox>
    <TextBlock Margin="0,8,0,0" Foreground="#9AA0AC" TextWrapping="Wrap"
               Text="This is the language of the game's text, not of this app (the app stays in English). You can change it later under Recognition: Game language." />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="UseButton" Content="Use this language" Padding="12,3" Margin="0,0,6,0" IsDefault="True" IsEnabled="False" Click="UseButton_Click" />
      <Button Content="Not now" Padding="12,3" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
