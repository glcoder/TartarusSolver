<Window x:Class="Tartarus.App.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tartarus Solver" Width="520" SizeToContent="Height" MinHeight="300"
        Topmost="True" ResizeMode="CanMinimize" FontFamily="Segoe UI" FontSize="12"
        Background="#1E1F24" Foreground="#E8E8EC">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E8E8EC" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#9AA0AC" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <Style x:Key="LabelBox" TargetType="TextBox">
      <Setter Property="Margin" Value="4,1,10,1" />
      <Setter Property="MinWidth" Value="40" />
    </Style>
  </Window.Resources>
  <StackPanel Margin="10">
    <!-- Target window and capture -->
    <TextBlock Style="{StaticResource Section}" Margin="0,0,0,4" Text="Game window" />
    <DockPanel>
      <Button x:Name="RefreshButton" DockPanel.Dock="Right" Margin="6,0,0,0" Content="⟳" ToolTip="Refresh the window list" Click="RefreshButton_Click" />
      <ComboBox x:Name="WindowCombo" />
    </DockPanel>
    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
      <Button x:Name="CaptureButton" Content="Capture ▶" Click="CaptureButton_Click" />
      <CheckBox x:Name="AutoAttachCheck" Content="Attach to the game automatically" IsChecked="True" />
    </StackPanel>
    <TextBlock x:Name="CaptureStatus" Margin="0,4,0,0" Foreground="#9AA0AC" TextWrapping="Wrap" Text="Not capturing" />

    <!-- Scanning -->
    <TextBlock Style="{StaticResource Section}" Text="Recognition" />
    <StackPanel Orientation="Horizontal">
      <Button x:Name="ScanButton" Content="Scan" Click="ScanButton_Click" />
      <CheckBox x:Name="AutoScanCheck" Content="Auto" Margin="0,0,4,0" Checked="AutoScanCheck_Changed" Unchecked="AutoScanCheck_Changed" />
      <Slider x:Name="IntervalSlider" Width="140" Minimum="0" Maximum="1" SmallChange="0.1" LargeChange="0.1" IsSnapToTickEnabled="True" TickFrequency="0.1" TickPlacement="BottomRight"
              ValueChanged="IntervalSlider_ValueChanged" ToolTip="Seconds from one frame to the next; 0: the next frame as soon as the last one's reading and hint are done" />
      <TextBlock x:Name="IntervalText" Margin="6,0,0,0" Text="0.5 s" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                ToolTip="The language the game shows its text in, so the app can read it. The app itself stays in English.">
      <TextBlock Text="Game language" Margin="0,0,6,0" />
      <ComboBox x:Name="GameLanguageCombo" Width="230" />
      <CheckBox x:Name="GameLanguageAutoCheck" Content="Detect automatically" Margin="10,0,0,0"
                ToolTip="Take the language from the game's settings file; off: choose it in the list yourself" />
    </StackPanel>
    <StackPanel x:Name="ViewPanel" Orientation="Horizontal" Margin="0,6,0,0">
      <CheckBox x:Name="OverlayCheck" Content="Overlay" Checked="OverlayCheck_Changed" Unchecked="OverlayCheck_Changed" />
      <CheckBox x:Name="BoxesCheck" Content="Interactable regions" ToolTip="Frame everything clickable: cells, cards, buttons, Torture Instrument and Chromatic slots, pick cards" Checked="BoxesCheck_Changed" Unchecked="BoxesCheck_Changed" />
      <CheckBox x:Name="TextCheck" Content="Text" ToolTip="OCR regions and the lines read, on the overlay" Checked="TextCheck_Changed" Unchecked="TextCheck_Changed" />
    </StackPanel>
    <TextBlock x:Name="ScanStatus" Margin="0,4,0,0" Foreground="#9AA0AC" TextWrapping="Wrap" Text="—" />

    <!-- Move hints -->
    <StackPanel>
      <TextBlock Style="{StaticResource Section}" Text="Hints" />
      <StackPanel x:Name="HintChecks" Orientation="Horizontal">
        <CheckBox x:Name="HintsCheck" Content="Move hints" Checked="HintsCheck_Changed" Unchecked="HintsCheck_Changed" />
        <CheckBox x:Name="HintsOnlyCheck" Content="Hints only" Margin="12,0,12,0" Checked="HintsOnlyCheck_Changed" Unchecked="HintsOnlyCheck_Changed" ToolTip="The overlay shows only the move frames and the hint line: no cells, Torture Instruments or Chromatic" />
        <CheckBox x:Name="HideAlternativesCheck" Content="Hide alternatives" ToolTip="Frame the best move alone; off: the moves as good as it are framed dashed beside it" Checked="HideAlternativesCheck_Changed" Unchecked="HideAlternativesCheck_Changed" />
      </StackPanel>
      <DockPanel Margin="0,6,0,0">
        <TextBlock DockPanel.Dock="Left" Text="Faster" Foreground="#9AA0AC" Margin="0,0,6,0" />
        <TextBlock DockPanel.Dock="Right" Text="Stronger" Foreground="#9AA0AC" Margin="6,0,0,0" />
        <Slider x:Name="HintSlider" Minimum="0" Maximum="6" IsSnapToTickEnabled="True" TickFrequency="1" TickPlacement="BottomRight" ValueChanged="HintSlider_ValueChanged" ToolTip="Playouts per move: longer to compute, stronger hint" />
      </DockPanel>
      <TextBlock x:Name="HintLevelText" Margin="0,2,0,0" TextWrapping="Wrap" Text="—" />
      <TextBlock x:Name="HintStatus" Margin="0,2,0,0" Foreground="#9AA0AC" TextWrapping="Wrap" Text="—" />
    </StackPanel>

    <!-- The game's log -->
    <TextBlock Style="{StaticResource Section}" Text="Game log" />
    <StackPanel Orientation="Horizontal">
      <Button x:Name="PickLogButton" Content="Choose…" ToolTip="Pick UE_game.log by hand: game folder\UE_game\TorchLight\Saved\Logs" Click="PickLogButton_Click" />
      <Button x:Name="AutoLogButton" Content="Auto" ToolTip="Find the log automatically: beside the running game, in Steam libraries, in the launcher's settings" Click="AutoLogButton_Click" />
    </StackPanel>
    <TextBlock x:Name="LogStatus" Margin="0,2,0,0" Foreground="#9AA0AC" TextWrapping="Wrap" Text="—" />

    <!-- Statistics -->
    <TextBlock Style="{StaticResource Section}" Text="Statistics" />
    <DockPanel>
      <Button x:Name="ResetStatsButton" DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center" Content="Reset" ToolTip="Clear the statistics and count from now on" Click="ResetStatsButton_Click" />
      <TextBlock x:Name="StatsText" TextWrapping="Wrap" Text="—" />
    </DockPanel>

    <!-- Debugging (the command line's debug flag): labels, dataset, what was read, the log -->
    <StackPanel x:Name="DebugPanel">
      <TextBlock Style="{StaticResource Section}" Text="Labels and dataset" />
      <StackPanel Orientation="Horizontal">
        <CheckBox x:Name="EditCheck" Content="Edit mode" Checked="EditCheck_Changed" Unchecked="EditCheck_Changed" />
        <Button x:Name="SaveButton" Content="Save frame" Click="SaveButton_Click" />
        <CheckBox x:Name="AutoCollectCheck" Content="Auto-collect" Margin="6,0,0,0" ToolTip="Save a frame to the dataset whenever the Sandbox read changes (with auto scan)" Checked="AutoCollectCheck_Changed" Unchecked="AutoCollectCheck_Changed" />
      </StackPanel>
      <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Warden" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="WardenBox" Style="{StaticResource LabelBox}" ToolTip="The Warden's cell, 1-16" />
        <TextBlock Grid.Row="0" Grid.Column="2" Text="Remaining Days" />
        <TextBox Grid.Row="0" Grid.Column="3" x:Name="DaysBox" Style="{StaticResource LabelBox}" />
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Destinations" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="DestinationsBox" Style="{StaticResource LabelBox}" ToolTip="Cells on the Destination cards, left to right: 9,11,12" />
        <TextBlock Grid.Row="1" Grid.Column="2" Text="Chromatic" />
        <TextBox Grid.Row="1" Grid.Column="3" x:Name="ChromaticBox" Style="{StaticResource LabelBox}" />
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Torture Instruments" />
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="InstrumentsBox" Style="{StaticResource LabelBox}" ToolTip="ids, comma-separated: ironbox,muzzle" />
      </Grid>
      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
        <Button x:Name="ApplyLabelsButton" Content="Apply fields" Click="ApplyLabelsButton_Click" />
        <Button x:Name="ResetLabelsButton" Content="Reset edits" Click="ResetLabelsButton_Click" />
        <Button x:Name="OpenDatasetButton" Content="Dataset folder" Click="OpenDatasetButton_Click" />
      </StackPanel>
      <TextBlock x:Name="DatasetStatus" Margin="0,4,0,0" Foreground="#9AA0AC" TextWrapping="Wrap" />
      <TextBlock Margin="0,4,0,0" Foreground="#6F7580" TextWrapping="Wrap"
                 Text="In edit mode click a cell on the overlay: a menu of Code, rarity and flags. Auto scan pauses while editing." />

      <!-- Sandbox summary and log -->
      <TextBlock Style="{StaticResource Section}" Text="Sandbox" />
      <TextBox x:Name="SandboxSummary" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
               Background="#15161A" Foreground="#D8D8DC" BorderThickness="0" MinHeight="48" />
      <TextBlock Style="{StaticResource Section}" Text="Log" />
      <ListBox x:Name="LogList" Height="120" FontFamily="Consolas" FontSize="11" Background="#15161A" Foreground="#C8C8CC" BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
    <DockPanel x:Name="UpdatePanel" Margin="0,8,0,0">
      <Button x:Name="UpdateButton" DockPanel.Dock="Right" Margin="6,0,0,0" Visibility="Collapsed" Click="UpdateButton_Click" />
      <CheckBox x:Name="UpdateCheck" Content="Check for updates" ToolTip="Ask GitHub for a new version at start and every 6 hours" Checked="UpdateCheck_Changed" Unchecked="UpdateCheck_Changed" />
    </DockPanel>
    <DockPanel Margin="0,8,0,0">
      <Button x:Name="ReportButton" DockPanel.Dock="Right" Margin="6,0,0,0" Content="Report a bug" ToolTip="Send the developer a screenshot, the app's log and the current run's log with your comment" Click="ReportButton_Click" />
      <TextBlock x:Name="VersionText" Foreground="#6F7580" TextWrapping="Wrap" Text="Version" />
    </DockPanel>
  </StackPanel>
</Window>
